        <mxCell id="lane_member" value="メンバー" style="swimlane;horizontal=1;startSize=30;fillColor=#F5F5F5;swimlaneFillColor=#FFFFFF;fontStyle=1;fontSize=14;strokeColor=#666666" vertex="1" parent="1">
