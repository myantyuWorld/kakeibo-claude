        <mxCell id="note_invite_one" value="同時に有効な招待 URL は 1 本&#10;新規発行で既存を自動無効化&#10;既に家計簿所属者は参加不可" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="575" y="595" width="140" height="70" as="geometry" />
