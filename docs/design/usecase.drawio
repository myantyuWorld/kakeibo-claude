        <mxCell id="note_invite_one_link" style="endArrow=none;dashed=1;html=1;edgeStyle=none;rounded=0;" edge="1" parent="1" source="note_invite_one" target="uc_invite_issue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note_csv_rule" value="管理者のみ実行可&#10;重複検知あり&#10;（同日付・同カテゴリ・同額）" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
